{
  "name": "Automated Lead-Sifting and Warmup System",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Iterate over input items \nfor (let item of $input.all()) {\n  let rawData = item.json;\n  \n  // Safely extract fields based on your exact n8n form output\n  // Using optional chaining (?.) to prevent crashes if 'Work' is missing\n  let emailRaw = rawData?.Work?.Email || rawData[\"Work Email\"] || rawData.email || \"\";\n  let email = emailRaw.toLowerCase().trim();\n  \n  let firstNameRaw = rawData[\"First Name\"] || rawData.firstName || \"\";\n  let lastNameRaw = rawData[\"Last Name\"] || rawData.lastName || \"\";\n  let jobTitleRaw = rawData[\"Job Title\"] || rawData.jobTitle || \"Unknown\";\n  \n  // 1. Clean and Normalize Name (Combine First and Last, capitalize correctly)\n  let fullName = `${firstNameRaw} ${lastNameRaw}`.trim();\n  let cleanName = fullName.split(' ')\n    .map(word => word ? word.charAt(0).toUpperCase() + word.slice(1).toLowerCase() : \"\")\n    .join(' ');\n\n  // 2. Extract Company Domain\n  let domain = \"\";\n  if (email.includes(\"@\")) {\n    domain = email.split(\"@\")[1];\n  }\n\n  // 3. Sift out non-B2B emails (Generic providers)\n  const genericDomains = ['gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'icloud.com'];\n  let isB2B = domain ? !genericDomains.includes(domain) : false;\n  \n  // 4. Pre-assign a base confidence score to save LLM tokens on obvious mismatches\n  let baseScore = 0;\n  if (isB2B) baseScore += 5;\n  if (jobTitleRaw.toLowerCase().match(/(ceo|founder|director|manager|vp|head)/)) baseScore += 5;\n\n  // 5. Reconstruct the output payload for the AI Classifier\n  item.json = {\n    original_payload: rawData,\n    sifted_data: {\n      name: cleanName || \"empty\",\n      email: email || \"empty\",\n      company_domain: domain || \"empty\",\n      job_title: jobTitleRaw,\n      is_b2b_domain: isB2B,\n      pre_qualification_score: baseScore\n    },\n    // The exact prompt string for the Gemini node\n    ai_prompt: `Analyze this lead: Name: ${cleanName}, Title: ${jobTitleRaw}, Domain: ${domain}. Is this a high-value B2B target? Categorize as Tier 1, Tier 2, or Unqualified.`\n  };\n}\n\nreturn $input.all();\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
