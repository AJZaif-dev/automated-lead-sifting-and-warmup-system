    {
      "parameters": {
        "jsCode": "const results = [];\nconst currentItems = $input.all();\nconst cleanupItems = $('DataCleanup').all();\n\nfor (let i = 0; i < currentItems.length; i++) {\n  // 1. Defensively find the AI's output wherever n8n decided to hide it today\n  let rawAi = currentItems[i].json.output || currentItems[i].json.text || currentItems[i].json.response || currentItems[i].json;\n\n  let aiData = {};\n\n  // 2. Safely parse the AI data without crashing\n  try {\n    if (typeof rawAi === 'string') {\n      // AI models love to wrap JSON in markdown backticks, which breaks JSON.parse(). This strips them out.\n      let cleanedString = rawAi.replace(/```json/g, '').replace(/```/g, '').trim();\n      aiData = JSON.parse(cleanedString);\n    } else {\n      // If n8n already converted it to a Javascript object behind the scenes\n      aiData = rawAi;\n    }\n  } catch (error) {\n    // A safe fallback so your lead-gen workflow doesn't break if the AI hallucinates bad formatting\n    aiData = { classification: \"Error\", reasoning: \"AI output could not be parsed.\" };\n  }\n\n  // 3. Fetch the cleaned data safely from your previous node\n  let cleanData = cleanupItems[i] && cleanupItems[i].json.sifted_data ? cleanupItems[i].json.sifted_data : {};\n\n  // 4. Output the flat row for Google Sheets\n  results.push({\n    json: {\n      name: cleanData.name,\n      email: cleanData.email,\n      company_domain: cleanData.company_domain,\n      job_title: cleanData.job_title,\n      classification: aiData.classification,\n      ai_reasoning: aiData.reasoning\n    }\n  });\n}\n\nreturn results;\n"
      },
